{
	"$schema": "https://json.schemastore.org/prettierrc",
	"semi": true,
	"tabWidth": 2,
	"singleQuote": true,
	"printWidth": 100,
	"trailingComma": "none",
	"useTabs": true,
	"arrowParens": "avoid",
	"bracketSpacing": true,
	"proseWrap": "always",
	"htmlWhitespaceSensitivity": "strict",
	"endOfLine": "lf"
}
